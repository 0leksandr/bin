#!/bin/sh


_complete_full()
{
    if [ $SHELL = $(which bash) ]; then
        local PATH="$(dirname "$(dirname "$(realpath "$0")")")"
        _command_offset 1
    fi
    if [ $SHELL = $(which zsh) ]; then
        COMPREPLY=( $(compgen -c) )
    fi
} &&
complete -F _complete_full copy fkill fuck not parallel proc procx restart save-output whatsin  dt dtb rdt rdtb rdtbo tb


_complete_by_options() {
    cur="${COMP_WORDS[COMP_CWORD]}"
    command=""
    i=0
    while [ $i -lt $COMP_CWORD ]; do
        command="$command ${COMP_WORDS[$i]}"
        i=$(($i + 1))
    done
    # cache options while the same command line is being completed
    if [ "$command" != "$_complete_by_options_key" ]; then
        _complete_by_options_key="$command"
        _complete_by_options_list=$($command help </dev/null |sed -r 's/Options: (.*)/\1/')
    fi
    COMPREPLY=( $(compgen -W "$_complete_by_options_list" -- ${cur}) )
}
complete -F _complete_by_options aqi brightness errors gsubmod kube light location release scene vivaldi-windows
_complete_by_options_reset() {
    _complete_by_options_key=""
}
if [ "$ZSH_VERSION" ]; then
    precmd_functions+=(_complete_by_options_reset)
else
    PROMPT_COMMAND="_complete_by_options_reset${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi


_complete_files() {
    case "$(_os)" in
        linux) COMPREPLY=( $(ls -CF --group-directories-first) ) ;;
        mac)   COMPREPLY=( $(ls -CF) )                           ;;
    esac
}
complete -F _complete_files gdf git-reset nr-files
