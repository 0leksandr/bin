#!/bin/sh
set -e

#src="$1"
#dest="$2"

src=${1%/}
name=${src##*[/:]}
dest=${2:-${name%.git}}

#git clone https://github.com/$src "$dest"
#git clone --recurse-submodules "git@github.com:$src" "$dest"
git clone --recurse-submodules                                                                 \
    "$(printf %s "$src" | sed -E '/:/! { \,/.*/,! s|^|github.com/|; s|^([^/]+)/|git@\1:|; }')" \
    "$dest"                                                                                    \
&&:

# initialize .git/FETCH_HEAD, used by `gst`
git -C "$dest" fetch

# add to the nearest my-repositories.txt in the parents of the repository, relative to its directory
path="$(realpath "$dest")"
file="my-repositories.txt"
root=${path%/*}
while [ -n "$root" ] && [ ! -f "$root/$file" ]; do
    root=${root%/*}
done
if [ -f "$root/$file" ]; then
    echo "${path#"$root"/}" |sort --unique --output="$root/$file" - "$root/$file"
else
    echo "$file not found in the parents of $path, not added" >&2
fi
