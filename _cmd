#!/bin/sh
# Run a command with arguments parsed from a shell-quoted string, without eval
# Usage: $0 [-c] [CMD [ARG...]] STRING
#   The last argument (STRING) is split into words on spaces and tabs, honoring
#   ', ", \ and \<newline>; no expansions of any kind are performed.
#   A newline outside quotes is part of the word (not a separator).
#   Everything before STRING is passed literally.
#   The command replaces this process (exec): PID, stdin, exit code and signals are preserved.
#   -c is optional and only makes the parsing explicit.
# Examples:
#   $0 "git status"
#   $0 git add -- "$files"
#   $0 -c git add -- "$files"
#   $0 "$cmd" & pid=$!

set -eu

if [ "${1:-}" = "-c" ]; then
    shift
fi

if [ "$#" -lt 1 ]; then
    echo "usage: $0 [-c] [CMD [ARG...]] STRING" >&2
    exit 2
fi

# Rotate: move the first n-1 arguments to the end, so STRING becomes $1
n=$#
i=1
while [ "$i" -lt "$n" ]; do
    set -- "$@" "$1"
    shift
    i=$((i + 1))
done

str=$1
shift

# Nothing to run
case $str in
    *[![:space:]]*) ;;
    *) exit 0 ;;
esac

nl=$(printf '\nx')
nl=${nl%x}
tab=$(printf '\t')

state=out   # out | single | double
word=
in_word=0   # distinguishes an empty word ('') from no word
rest=$str

while [ -n "$rest" ]; do
    tail=${rest#?}
    ch=${rest%"$tail"}
    rest=$tail

    case $state in
        out)
            case $ch in
                ' ' | "$tab")
                    if [ "$in_word" -eq 1 ]; then
                        set -- "$@" "$word"
                        word=
                        in_word=0
                    fi
                    ;;
                "'") state=single; in_word=1 ;;
                '"') state=double; in_word=1 ;;
                \\)
                    if [ -z "$rest" ]; then
                        word=$word$ch
                        in_word=1
                    else
                        tail=${rest#?}
                        next=${rest%"$tail"}
                        rest=$tail
                        if [ "$next" != "$nl" ]; then
                            word=$word$next
                            in_word=1
                        fi
                    fi
                    ;;
                *) word=$word$ch; in_word=1 ;;
            esac
            ;;
        single)
            case $ch in
                "'") state=out ;;
                *) word=$word$ch ;;
            esac
            ;;
        double)
            case $ch in
                '"') state=out ;;
                \\)
                    tail=${rest#?}
                    next=${rest%"$tail"}
                    case $next in
                        '"' | \\ | '$' | '`')
                            word=$word$next
                            rest=$tail
                            ;;
                        "$nl") rest=$tail ;;
                        *) word=$word$ch ;;
                    esac
                    ;;
                *) word=$word$ch ;;
            esac
            ;;
    esac
done

if [ "$state" != out ]; then
    echo "$0: unmatched quote in string" >&2
    exit 2
fi

if [ "$in_word" -eq 1 ]; then
    set -- "$@" "$word"
fi

exec "$@"
