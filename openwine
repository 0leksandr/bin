#!/bin/sh
set -e

program="$1"
path="$2"
prefix="$3"

if [ "$path" != "" ]; then
    if ! echo "$path" |grep -Eq "^/"; then
        path="$(pwd)/$path"
    fi
    path="Z:$(echo "$path" |tr '/' "\\")"
fi

# /etc/zprofile defaults LANG to C.UTF-8, wine then resets International registry to en-US
[ "$(_os)" = mac ] && unset LANG LC_ALL LC_CTYPE

if [ "$prefix" != "" ]; then
    # to initialize:
    # - `WINEPREFIX=~/_/Programs/.wine2 regedit`
    # - set:
    #   My Computer
    #   > HKEY_CURRENT_USER
    #   > Control Panel
    #   > International
    #     edit:
    #     - sShortDate: yyyy-MM-dd
    #     - sTimeFormat: HH:mm:ss

    WINEPREFIX="$prefix" wine reg add "HKCU\Control Panel\International" /v sShortDate /t REG_SZ /d "yyyy-MM-dd" /f

    WINEPREFIX="$prefix" wine "$program" "$path"
else
    wine "$program" "$path"
fi
