#!/bin/sh
set -e
branch="$1"

git merge "$branch"

printf 'Delete branch %s? (y/n) ' "$branch"
read -r answer
[ "$answer" = y ] || exit 0

git branch --delete "$branch"

if git ls-remote --exit-code --heads origin "$branch" > /dev/null; then
    git push origin --delete "$branch"
    git fetch origin --prune
fi
