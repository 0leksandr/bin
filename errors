#!/bin/sh
set -e
dir=/tmp/errors
alerted_dir=/tmp/errors-alerted  # alerted sizes; outside "$dir", so that writes do not trigger `listen`
command_process="__process"  # internal, for `find -exec` in scan()

process() {
    path="$1"
    name="${path##*/}"

    size=$(($(wc -c < "$path")))
    alerted=$(($(cat "$alerted_dir/$name" 2>/dev/null || echo 0)))
    if [ $size -lt $alerted ]; then alerted=0; fi  # the file was truncated
    if [ $size -gt $alerted ]; then
        content="$(tail -c +$((alerted + 1)) "$path" |head -c $((size - alerted)))"
        echo $size > "$alerted_dir/$name"
        if [ "$content" ]; then
            alert "$name: $content"
        fi
    fi
}

scan() {
    find "$dir" -mindepth 1 -maxdepth 1 -type f -exec "$0" "$command_process" {} \;
}

case "$1" in
    for)
        name="$2"
        reg='^([^ ]*/)?([0-9a-zA-Z._-]{1,30})( .*)?$'
        if echo "$name" |grep -Eq "$reg"; then
            name="$(echo "$name" |sed -r "s#$reg#\2#")"
        else
            name="$PPID"
        fi
        echo "$dir/$name"
        ;;
    init)
        mkdir -p "$dir" "$alerted_dir"
        find "$dir" "$alerted_dir" -mindepth 1 -delete
        ;;
    listen)
        _highlander
        mkdir -p "$dir" "$alerted_dir"
        scan
        case "$(_os)" in
            linux) inotifywait --monitor --quiet --event MODIFY -- "$dir" ;;
            mac)   fswatch -- "$dir" ;;
        esac |while read -r _; do
            scan
        done
        ;;
    "$command_process")
        process "$2"
        ;;
    help) echo "Options: for init listen" ;;
    *) echo "unknown option: $1" >>"$($0 for "$0")"; exit 1 ;;
esac
