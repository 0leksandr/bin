#!/bin/sh
set -e

printf "uv? (y/n) "
case "$(head -1)" in
    y)
        cat << END
uv venv                        # create a .venv (replaces python -m venv)
uv pip install numpy           # install into active/nearby venv (replaces pip install)
uv pip list / uv pip freeze    # same as pip
uv pip compile requirements.in # lockfile generation (replaces pip-compile)

uv init --bare myproject       # new project with pyproject.toml
uv add numpy                   # add a dependency (replaces manual pip + editing pyproject.toml)
uv run script.py               # run inside the project's venv automatically, no activation needed
uv sync                        # install exact deps from lockfile

uv tool install openai-whisper # pipx equivalent — isolated CLI tool
uv tool list / uv tool upgrade
uv python install 3.12         # also manages Python versions itself (replaces pyenv)

uv add my --index oleksandr=https://0leksandr.github.io/my.py/
END
        uv init --bare
        uv add -r requirements.txt
        uv remove my
        uv add my --index oleksandr=https://0leksandr.github.io/my.py/
        exit
        ;;
    n) : ;;
    *) echo>&2 "unknown input"; exit 1 ;;
esac

version="$1"

python="python$version"
reg="^Python ((([0-9]+)\\.[0-9]+)\\.[0-9]+)$"
version_str="$($python --version)"
if echo "$version_str" |grep -Eq "$reg"; then
    version1="$(echo "$version_str" |sed -r "s/$reg/\3/")"
    version2="$(echo "$version_str" |sed -r "s/$reg/\2/")"
    version3="$(echo "$version_str" |sed -r "s/$reg/\1/")"
else
    echo>&2 "Invalid version: $version_str"
    exit 1
fi

mkdir -p .venv
venv=".venv/$version3"
$python -m venv "$venv"
pip="./$venv/bin/pip"
"$pip" install --upgrade pip setuptools wheel

requirements=""
for candidate in                     \
        "requirements.txt"           \
        "requirements-$version1.txt" \
        "requirements-$version2.txt" \
        "requirements-$version3.txt" \
        ; do
    if [ -f "$candidate" ]; then
        requirements="$candidate"
    fi
done
if [ "$requirements" ]; then
    "$pip" install -r "$requirements"
fi
