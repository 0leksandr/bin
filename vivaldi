#!/bin/sh
set -e

case "$(_os)" in
    linux)
        #"$(_real "$0")"
        notify "$0 is not set"
        ;;
    mac)
        /Applications/Vivaldi.app/Contents/MacOS/Vivaldi \
            --flag-switches-begin                        \
            --flag-switches-end                          \
            --restore-last-session                       \
            --save-page-as-mhtml                         \
            --enable-smooth-scrolling                    \
            --remote-debugging-port=9222                 \
        &&:
        ;;
esac
